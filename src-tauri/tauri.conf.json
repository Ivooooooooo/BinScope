{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BinScope",
  "version": "0.1.0",
  "identifier": "com.binscope.analyzer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BinScope",
        "width": 1084,
        "height": 661,
        "minWidth": 880,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark",
        "backgroundColor": "#0b0e13",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "DeveloperTool",
    "shortDescription": "Static binary analyzer",
    "longDescription": "BinScope is a fast, offline-first static analyzer for PE, .NET, ELF and Mach-O files with compiler, packer, signature and YARA-X detections.",
    "copyright": "BinScope contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../rules/yara": "rules/yara",
      "../databases/signatures": "databases/signatures",
      "../databases/die": "databases/die"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerHooks": "nsis/hooks.nsh"
      }
    }
  }
}
